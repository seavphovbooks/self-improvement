  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">
    <dc:identifier id="BookId" opf:scheme="UUID">urn:uuid:4b4d7d5d-a3e4-4237-a39f-a83ac8795210</dc:identifier>
    <dc:title>The 7 Habits of Highly Effective People</dc:title>
    <dc:identifier opf:scheme="ISBN">9780795323423</dc:identifier>
    <dc:creator opf:role="aut">Stephen R. Covey</dc:creator>
    <dc:publisher>RosettaBooks</dc:publisher>
